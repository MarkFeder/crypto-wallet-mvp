# Crypto Wallet MVP - Environment Configuration
# Copy this file to .env for local development
#
# For cloud deployments, see:
# - src/config/.env.qa         (QA environment)
# - src/config/.env.main       (Main branch / pre-production)
# - src/config/.env.production (Production)

# =============================================================================
# LOCAL DEVELOPMENT (PostgreSQL)
# =============================================================================

# Database Configuration (local PostgreSQL)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=crypto_wallet_dev
DB_PASSWORD=postgres
DB_PORT=5432

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret (safe to use simple value in development)
JWT_SECRET=dev-secret-key-not-for-production

# =============================================================================
# MNEMONIC ENCRYPTION KEY (REQUIRED in every environment, including Vercel)
# =============================================================================
# 32 bytes expressed as 64 hex characters. Wallet seed phrases are encrypted at
# rest with AES-256-GCM under this key; the application refuses to store a
# mnemonic without it rather than silently falling back to plaintext.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Losing this value means already-stored mnemonics cannot be recovered, so back
# it up somewhere other than the deployment environment.
MNEMONIC_ENCRYPTION_KEY=replace-with-64-hex-characters

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000/api

# Webpack Dev Server
WEBPACK_DEV_SERVER_PORT=3000

# =============================================================================
# CLOUD DEPLOYMENT (Neon PostgreSQL)
# =============================================================================
# Uncomment and use DATABASE_URL instead of individual DB_* vars for cloud
#
# NEON SETUP:
# 1. Create account at https://neon.tech
# 2. Create project "crypto-wallet"
# 3. Create branches:
#    - production (for production deployments)
#    - main       (for main branch / pre-prod)
#    - qa         (for QA testing)
# 4. Get connection strings from each branch dashboard
# 5. Set APP_ENV in Vercel to match: development, qa, main, production
#
# APP_ENV=development
# DATABASE_URL=postgresql://neondb_owner:password@ep-xxx.neon.tech/neondb?sslmode=require

# =============================================================================
# RATE LIMITING (Upstash Redis)
# =============================================================================
# Required for rate limiting in production.
# 1. Create account at https://upstash.com
# 2. Create a new Redis database
# 3. Copy REST URL and Token from the dashboard
#
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here
